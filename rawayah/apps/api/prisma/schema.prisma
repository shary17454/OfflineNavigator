generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  VERIFIED
  PUBLISHED
  REJECTED
  ARCHIVED
  HIDDEN
}

enum VerificationLevel {
  VERIFIED
  PARTIAL
  ORAL
  DISPUTED
  INCOMPLETE
  UNDER_REVIEW
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum ContentType {
  POEM
  STORY
  BOOK
  HISTORICAL_EVENT
  TRIBE
  PLACE
  PROVERB
  VOCABULARY_TERM
  HORSE
  CAMEL
  FALCON
  HUNTING_DOG
  QUESTION
  COMMENT
  POET
  MANUSCRIPT
  HORSE_BREED
  CAMEL_BREED
  FALCON_BREED
  HUNTING_DOG_BREED
  HUNTING_ARTICLE
  HUNTING_DOG_ARTICLE
  NARRATOR
  RECORDING
  SOURCE
  TOPIC
  ARTICLE
  POET_FILE
  POET_FILE_ITEM
}

// نوع العضوية المهنية التي يتقدّم لها المستخدم.
enum ContributorType {
  NARRATOR
  HISTORIAN
}

enum ContributorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
}

// شكل المادة داخل مكتبة الشاعر.
enum PoetFileItemKind {
  TEXT
  AUDIO
  VIDEO
  IMAGE
  DOCUMENT
  EXTERNAL_LINK
}

// أبعاد تصنيف الشعر. القصيدة الواحدة تحمل مصطلحًا من كل بُعد عند
// الحاجة، وقد تحمل عدة أغراض (THEME) في آنٍ واحد — لذلك التصنيف
// علاقة متعدد-إلى-متعدد لا حقل واحد على القصيدة.
enum PoetryTaxonomyDimension {
  TRADITION
  ERA
  THEME
  REGION
  PERFORMANCE
  COLLECTION
}

// سير مراجعة مساهمات الرواة والمؤرخين.
enum ContributionReviewState {
  DRAFT
  SUBMITTED
  OWNER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
}

// وثائق السياسات القابلة للتحرير من لوحة المالك.
enum PolicyDocumentCode {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  CONTENT_POLICY
  CONTRIBUTOR_AGREEMENT
  COPYRIGHT_POLICY
  TAKEDOWN_POLICY
  SOURCE_POLICY
  CITATION_POLICY
  ORAL_HISTORY_POLICY
  RIGHTS_POLICY
  REPORTING_POLICY
  ACCOUNT_DELETION_POLICY
  COMMUNITY_GUIDELINES
}

// نوع التعارض بين مصدرين — يحدد طبيعة الخلاف لا مجرد وجوده.
enum SourceConflictType {
  ATTRIBUTION      // نسبة النص إلى قائل مختلف
  TEXT_VARIANT     // اختلاف في نص القصيدة أو الرواية
  DATE             // اختلاف في تاريخ ميلاد أو وفاة أو حدث
  PLACE            // اختلاف في المكان
  LINEAGE          // اختلاف في النسب أو القبيلة
  EVENT_DETAIL     // اختلاف في تفاصيل حدث
  NAME             // اختلاف في الاسم أو الكنية أو اللقب
  OTHER
}

// مستوى الثقة في حسم الخلاف — منفصل عن حالة الحسم نفسها، فقد يُرجَّح
// طرف بثقة منخفضة، وهذا يجب أن يظهر لا أن يختفي خلف كلمة "محسوم".
enum ConflictConfidence {
  UNRESOLVED
  LOW
  MEDIUM
  HIGH
}

// نتيجة مراجعة المالك للخلاف. القيمة الافتراضية `PENDING` مقصودة:
// لا يُحسم خلاف تلقائيًا بلا مراجعة بشرية.
enum ConflictResolution {
  PENDING
  SOURCE_A_PREFERRED
  SOURCE_B_PREFERRED
  BOTH_PUBLISHED_AS_DISPUTED
  INSUFFICIENT_EVIDENCE
}

// نوع الموافقة الصريحة المسجَّلة على المستخدم.
enum ConsentType {
  NARRATOR_PUBLIC_PROFILE
  HISTORIAN_PUBLIC_PROFILE
  CONTRIBUTOR_AGREEMENT
  POLICY_ACCEPTANCE
}

// دقة التاريخ التراثي — كثير من تواريخ الشعراء تقريبية أو مختلف فيها،
// ولا يجوز عرض تاريخ ظني كأنه مؤكد.
enum DatePrecision {
  EXACT
  YEAR
  DECADE
  CENTURY
  APPROXIMATE
  DISPUTED
  UNKNOWN
}

enum RightsStatus {
  UNKNOWN
  UNDER_REVIEW
  PUBLIC_DOMAIN
  LICENSED
  PERMISSION_GRANTED
  RESTRICTED
  EXPIRED
  TAKEDOWN_REQUESTED
}

enum IngestionMethod {
  MANUAL_CSV
  MANUAL_JSON
  MANUAL_ENTRY
  API
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum IngestionStage {
  COLLECTED
  NORMALIZED
  DUPLICATE_CHECK
  SOURCE_CHECK
  FACT_CHECK
  RIGHTS_CHECK
  HUMAN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum ValidationCheckType {
  NAME
  ATTRIBUTION
  DATE
  PLACE
  TEXT_MATCH
  PAGE_REFERENCE
  SUPPORTING_SOURCE
  CONFLICTING_SOURCE
  RIGHTS
  DUPLICATE_RISK
  CONFUSION_RISK
  SOURCE_QUALITY
}

enum DuplicateStatus {
  PENDING
  CONFIRMED_DUPLICATE
  NOT_DUPLICATE
  MERGED
}

enum SuggestionType {
  CORRECTION
  NEW_SOURCE
  NEW_CONTENT
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NameVariantType {
  ALT_NAME
  KUNYA
  LAQAB
  SPELLING
}

enum PassageKind {
  PARAGRAPH
  VERSE
  CLAIM
}

enum ConsensusStatus {
  AGREED
  DISPUTED
}

enum SearchSource {
  KEYWORD
  SUGGESTION
  TAG
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  status        UserStatus @default(ACTIVE)
  isEmailVerified Boolean @default(false)
  mustChangePassword Boolean @default(false)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  lastLoginAt   DateTime?
  profile       Profile?
  comments      Comment[]
  favorites     Favorite[]
  follows       Follow[]
  readingLists  ReadingList[]
  ratings       Rating[]
  questions     Question[]
  answers       Answer[]
  notifications Notification[]
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  commentReports CommentReport[]
  contentReports ContentReport[]
  moderationLogs ModerationLog[]
  auditLogs      AuditLog[]
  payments       Payment[]
  trustAssessments TrustAssessment[]

  submittedSuggestions ContentSuggestion[] @relation("SuggestionSubmittedBy")
  reviewedSuggestions  ContentSuggestion[] @relation("SuggestionReviewedBy")
  createdIngestionJobs  IngestionJob[] @relation("IngestionJobCreatedBy")
  approvedIngestionJobs IngestionJob[] @relation("IngestionJobApprovedBy")
  validationChecks     ValidationResult[]
  resolvedDuplicates   DuplicateCandidate[]
  rightsRecords        RightsRecord[]
  publishedBatches     PublishingBatch[] @relation("PublishingBatchPublishedBy")
  rolledBackBatches    PublishingBatch[] @relation("PublishingBatchRolledBackBy")

  contributorApplications ContributorApplication[] @relation("ContributorApplicationUser")
  reviewedContributorApplications ContributorApplication[] @relation("ContributorApplicationReviewedBy")
  contributedPoetFileItems PoetFileItem[] @relation("PoetFileItemContributedBy")
  reviewedPoetFileItems    PoetFileItem[] @relation("PoetFileItemReviewedBy")
  publishedPoetFileItems   PoetFileItem[] @relation("PoetFileItemPublishedBy")
  consentRecords           ConsentRecord[] @relation("ConsentRecordUser")
  policyAcceptances        PolicyAcceptance[] @relation("PolicyAcceptanceUser")
  reviewedSourceConflicts  SourceConflict[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  fullName    String?
  displayName String?
  avatar      String?
  bio         String?
  phoneNumber String?
  location    String?
  preferredLocale String @default("ar")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  nameAr      String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userRoles   UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  nameAr      String
  scope       String
  createdAt   DateTime @default(now())
  rolePermissions RolePermission[]
}

model UserRole {
  id      String @id @default(cuid())
  userId  String
  roleId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Poet {
  id            String   @id @default(cuid())
  slug          String   @unique
  fullName      String
  knownAs       String?
  imageUrl      String?
  birthDate     String?
  deathDate     String?
  region        String?
  era           String?
  biography     String?
  notableEvents String?
  summary       String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status        ContentStatus @default(DRAFT)
  sourceNotes   String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  reviewedBy    String?
  publishedBy   String?

  // كنية الشاعر ولقبه. طرق كتابة الاسم الأخرى تُخزَّن في NameVariant
  // (contentType = POET) بدل تكرار حقول نصية هنا.
  kunya         String?
  laqab         String?
  // دقة تاريخي الميلاد والوفاة — تمنع عرض تاريخ ظني كأنه مؤكد.
  birthDatePrecision DatePrecision @default(UNKNOWN)
  deathDatePrecision DatePrecision @default(UNKNOWN)
  // ملاحظة تُعرض للقارئ عند اختلاف المصادر حول التواريخ أو النسب.
  disputeNote   String?
  lastReviewedAt DateTime?
  lastReviewedBy String?

  poems         Poem[]
  stories       Story[]
  attributions  PoemAttribution[]
  file          PoetFile?
  @@index([fullName])
}

model Poem {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String?
  body          String
  status        ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  language      String   @default("ar")
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  reviewedBy    String?
  publishedBy   String?
  poetId        String
  topic         String?
  era           String?
  region        String?
  tribe         String?
  meter         String?
  occasion      String?
  poemStory     String?
  explanation   String?
  difficultyWords Json?
  imageUrl      String?
  isOfficial    Boolean @default(true)
  viewCount     Int @default(0)
  saveCount     Int @default(0)
  ratingAverage Float? @default(0)

  poet          Poet @relation(fields: [poetId], references: [id], onDelete: Cascade)
  versions      PoemVersion[]
  attributions  PoemAttribution[]
  poetFileItems PoetFileItem[]
  taxonomies    PoemTaxonomy[]
}

model Story {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  summary    String?
  body       String
  narrator   String?
  researcher String?
  characters Json?
  location   String?
  era        String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status     ContentStatus @default(DRAFT)
  language   String @default("ar")
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  reviewedBy String?
  publishedBy String?
  viewCount  Int @default(0)
  saveCount  Int @default(0)
  poetId     String?

  poet       Poet? @relation(fields: [poetId], references: [id], onDelete: SetNull)
}

model HistoricalEvent {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String?
  body            String
  era             String?
  region          String?
  status          ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  language        String @default("ar")
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  reviewedBy      String?
  publishedBy     String?

}

model Tribe {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  summary         String?
  body            String
  region          String?
  status          ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(DISPUTED)
  sensitive       Boolean @default(true)
  allowComments   Boolean @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  reviewedBy      String?
  publishedBy     String?

}

model Place {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  latitude        Float?
  longitude       Float?
  mediaUrl        String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  reviewedBy      String?
  publishedBy     String?
  isSensitive     Boolean @default(false)

}

model Book {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String?
  body          String?
  status        ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  language      String @default("ar")
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  reviewedBy    String?
  publishedBy   String?
  author        String?
  editor        String?
  publisher     String?
  publishedYear String?
  edition       String?
  pages         Int?
  isbn          String?
  rights        String?
  purchaseUrl   String?

}

model Manuscript {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  summary    String?
  content    String?
  status     ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  sourceId   String?
}

model Proverb {
  id        String   @id @default(cuid())
  slug      String   @unique
  phrase    String
  explanation String
  story     String?
  region    String?
  usage     String?
  language  String @default("ar")
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status    ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  reviewedBy String?
  publishedBy String?
}

model VocabularyTerm {
  id        String   @id @default(cuid())
  slug      String   @unique
  term      String
  pronunciation String?
  meaning   String
  usage     String?
  example   String?
  dialect   String?
  language  String @default("ar")
  audioUrl  String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status    ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  reviewedBy String?
  publishedBy String?

  occurrences TermOccurrence[]
}

model Horse {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  summary    String?
  description String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status     ContentStatus @default(DRAFT)
  language   String @default("ar")
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  reviewedBy String?
  publishedBy String?
  breeds     HorseBreed[]
}

model HorseBreed {
  id             String   @id @default(cuid())
  horseId        String
  name           String
  origin         String?
  traitSummary   String?
  usage          String?
  photos         String?

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
}

model Camel {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  summary        String?
  description    String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status         ContentStatus @default(DRAFT)
  language       String @default("ar")
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  reviewedBy     String?
  publishedBy    String?
  breeds         CamelBreed[]
}

model CamelBreed {
  id           String   @id @default(cuid())
  camelId      String
  name         String
  origin       String?
  traits       String?
  usage        String?
  photos       String?

  camel Camel @relation(fields: [camelId], references: [id], onDelete: Cascade)
}

model Falcon {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  summary    String?
  description String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status     ContentStatus @default(DRAFT)
  language   String @default("ar")
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  reviewedBy String?
  publishedBy String?
  breeds     FalconBreed[]
}

model FalconBreed {
  id         String   @id @default(cuid())
  falconId   String
  name       String
  origin     String?
  traits     String?
  usage      String?
  photos     String?

  falcon Falcon @relation(fields: [falconId], references: [id], onDelete: Cascade)
}

model HuntingArticle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String?
  body            String
  status          ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  region          String?
  era             String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  reviewedBy      String?
  publishedBy     String?
  updatedByLaw     String?
}

model HuntingDogBreed {
  id         String @id @default(cuid())
  name       String
  origin     String?
  traits     String?
  usage      String?
  imageUrl   String?
}

model HuntingDogArticle {
  id      String   @id @default(cuid())
  slug    String   @unique
  title   String
  summary String?
  body    String
  breedId String?
  status  ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  reviewedBy String?
  publishedBy String?
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  section     String
  orderIndex  Int @default(0)
  isVisible   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contentTags ContentTag[]
}

model ContentTag {
  id         String @id @default(cuid())
  contentType ContentType
  contentId  String
  tagId      String
  createdAt  DateTime @default(now())

  tag        Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([contentType, contentId])
}

model Source {
  id          String   @id @default(cuid())
  title       String
  author      String?
  editor      String?
  publisher   String?
  edition     String?
  pageNumber  String?
  publicationYear Int?
  link        String?
  sourceType  String
  notes       String?
  // تقييم جودة المصدر: 1 (وثيقة/مخطوطة أصلية) إلى 5 (منتدى/مجهول المصدر). لا يُنشر محتوى يعتمد على المستوى 5 فقط.
  tier        Int?
  tierReason  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean @default(true)
  contentSources ContentSource[]
  passageSources PassageSource[]
  narrations     Narration[]
  timelineEvents TimelineEvent[]
  contentSuggestions ContentSuggestion[]
  lineageAsSource SourceLineage[] @relation("SourceLineageSource")
  lineageAsParent SourceLineage[] @relation("SourceLineageParent")
  poetFileItems  PoetFileItem[]
  conflictsAsA   SourceConflict[] @relation("SourceConflictA")
  conflictsAsB   SourceConflict[] @relation("SourceConflictB")
}

model ContentSource {
  id         String @id @default(cuid())
  contentType ContentType
  contentId   String
  sourceId    String
  createdAt   DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([contentType, contentId])
}

model MediaFile {
  id          String @id @default(cuid())
  contentType ContentType
  contentId   String
  mimeType    String
  url         String
  size        Int
  originalName String
  storageKey  String
  uploadedBy  String?
  isPrivate   Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([contentType, contentId])
}

model AudioTrack {
  id          String @id @default(cuid())
  contentType ContentType
  contentId   String
  title       String
  narrator    String?
  fileUrl     String
  durationMs  Int?
  license     String?
  isDownloadable Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Video {
  id          String @id @default(cuid())
  contentType ContentType
  contentId   String
  title       String
  description String?
  posterUrl   String?
  durationMs  Int?
  fileUrl     String
  subtitleUrl String?
  license     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id         String @id @default(cuid())
  contentType ContentType
  contentId  String
  userId     String
  body       String
  isHidden   Boolean @default(false)
  isDeleted  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentThread")
  reportCounts CommentReport[]

  @@index([contentType, contentId])
}

