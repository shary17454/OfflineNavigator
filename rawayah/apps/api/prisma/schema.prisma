// =========================================================
// شبكة المعرفة والبنية التوسعية لمنصة رواية التراث
// النماذج التالية تؤسس للبنية التقنية التي تستوعب مستقبلًا:
// شبكة المعرفة، بطاقة الثقة، التوثيق على مستوى الفقرة،
// شجرة المصادر، مقارنة الروايات، رحلة المحتوى والخط الزمني،
// معجم الكلمات القابل للنقر، وأرشيف الرواة الشفهي.
// حتى لو لم تُبنَ كل واجهات الاستخدام في هذه المرحلة، البنية
// جاهزة لاستيعابها دون إعادة هيكلة قاعدة البيانات.
// =========================================================

// شبكة المعرفة: يربط أي عنصر (قصيدة، شاعر، مكان، حدث، مصدر...)
// بأي عنصر آخر عبر علاقة موصوفة (relationType نصي مفتوح لمرونة كاملة).
model EntityRelation {
  id           String   @id @default(cuid())
  sourceType   ContentType
  sourceId     String
  targetType   ContentType
  targetId     String
  relationType String   // مثال: شاعر، قصة_القصيدة، مكان_مذكور، عاصر، نافس، مدح، هجا، روى_عنه، تعلم_منه
  label        String?  // نص عربي يُعرض للمستخدم عند التنقل بين العلاقات
  note         String?
  confidence   VerificationLevel @default(UNDER_REVIEW)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationType])
}

// بطاقة الثقة: تقييم منفصل لكل عنصر محتوى يوضح درجة الثقة وسببها
// ومصادرها ومدى الاتفاق أو الاختلاف عليها، بدل الاكتفاء بكلمة "موثّق".
model TrustAssessment {
  id                     String   @id @default(cuid())
  contentType            ContentType
  contentId              String
  score                  Int      // 0-100
  reasoning              String
  sourceCount            Int      @default(0)
  sourceStrength         String?
  hasConflictingSources  Boolean  @default(false)
  isOralNarration        Boolean  @default(false)
  consensusStatus        ConsensusStatus @default(AGREED)
  lastReviewedAt         DateTime?
  nextReviewAt           DateTime?
  reviewedById           String?
  reviewedByName         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  reviewedBy User? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  conflicts  SourceConflict[]

  @@unique([contentType, contentId])
}

// تعارض المصادر: عندما يختلف مصدران على نفس المعلومة، يُحفظ الخلاف نفسه
// سجلًّا مستقلًا لا يُحذف ولا يُحسم تلقائيًا.
//
// الحقل `hasConflictingSources` على بطاقة الثقة كان علمًا منطقيًا فقط —
// يقول "هناك خلاف" ولا يقول ما هو ولا بين مَن، فلا يمكن للمراجع أن يبني
// عليه قرارًا ولا للقارئ أن يفهم منه شيئًا. هذا النموذج يحفظ الخلاف
// بتفاصيله كاملة كما تقتضي سياسة المصادر.
model SourceConflict {
  id          String      @id @default(cuid())
  contentType ContentType
  contentId   String

  // موضع الخلاف بدقة: قد يكون على القصيدة كاملة، أو على بيت واحد منها،
  // أو على تاريخ وفاة شاعر. تركه مبهمًا يجعل السجل بلا فائدة عملية.
  subject     String

  conflictType SourceConflictType

  // كل طرف بمصدره وبنص الرواية التي يدعمها ذلك المصدر تحديدًا. لا يُكتفى
  // بربط المصدرين دون نص، لأن الخلاف في المضمون لا في هوية المصدر.
  sourceAId      String
  sourceAClaim   String
  sourceBId      String
  sourceBClaim   String

  // مصادر إضافية تؤيد أحد الطرفين أو تطرح ثالثًا — الخلاف قد يكون ثلاثيًا،
  // فتُسجَّل البقية هنا بدل إجبارها على ثنائية لا تمثّلها.
  additionalNotes String?

  reviewerNotes  String?
  confidence     ConflictConfidence @default(UNRESOLVED)
  resolution     ConflictResolution @default(PENDING)

  // عند تعذّر الحسم تُنشر المادة موسومة «مختلف فيها»، وهذا النص هو ما
  // يُعرض للقارئ بجوارها.
  publicDisputeNote String?

  trustAssessmentId String?
  reviewedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sourceA         Source           @relation("SourceConflictA", fields: [sourceAId], references: [id], onDelete: Cascade)
  sourceB         Source           @relation("SourceConflictB", fields: [sourceBId], references: [id], onDelete: Cascade)
  trustAssessment TrustAssessment? @relation(fields: [trustAssessmentId], references: [id], onDelete: SetNull)
  reviewedBy      User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
  @@index([resolution])
}

// التوثيق على مستوى الفقرة: يقسّم أي عنصر محتوى إلى وحدات أصغر
// (فقرة/بيت شعر/ادعاء) قابلة لامتلاك مصدر وشرح وملاحظة مستقلة.
model Passage {
  id              String   @id @default(cuid())
  contentType     ContentType
  contentId       String
  kind            PassageKind @default(PARAGRAPH)
  orderIndex      Int      @default(0)
  text            String
  explanation     String?
  occasion        String?
  difficultyWords Json?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sources         PassageSource[]
  termOccurrences TermOccurrence[]
  narrations      Narration[]

  @@index([contentType, contentId])
}

model PassageSource {
  id        String   @id @default(cuid())
  passageId String
  sourceId  String
  note      String?
  createdAt DateTime @default(now())

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([passageId])
  @@index([sourceId])
}

// شجرة المصادر: سلسلة انتقال المعلومة من مصدر إلى المصدر الذي نُقلت عنه.
model SourceLineage {
  id               String   @id @default(cuid())
  sourceId         String
  derivedFromId    String?
  transmissionType String   // نقل_عن / مخطوطة / رواية_شفوية / طبعة
  note             String?
  createdAt        DateTime @default(now())

  source      Source  @relation("SourceLineageSource", fields: [sourceId], references: [id], onDelete: Cascade)
  derivedFrom Source? @relation("SourceLineageParent", fields: [derivedFromId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([derivedFromId])
}

// مقارنة الروايات: عدة نسخ/روايات لنفس القصيدة أو القصة أو الحدث
// (أو لفقرة محددة عبر passageId) مع مصدر ودرجة ثقة لكل رواية.
model Narration {
  id                String   @id @default(cuid())
  contentType       ContentType
  contentId         String
  passageId         String?
  label             String
  body              String
  differenceNote    String?
  sourceId          String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  passage Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  source  Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
}

// الخط الزمني: يخدم كلًا من "رحلة القصيدة" (category = TRANSMISSION)
// و"الخط الزمني" العام لأي شخصية أو مكان أو حدث (category = BIOGRAPHICAL/HISTORICAL).
model TimelineEvent {
  id          String   @id @default(cuid())
  subjectType ContentType
  subjectId   String
  category    String   // BIOGRAPHICAL | HISTORICAL | TRANSMISSION | GENERAL
  title       String
  eventDate   String?
  era         String?
  actorName   String?  // لمن قام بالحدث عند نوع النقل (راوٍ/شارح/ناسخ)
  description String?
  sourceId    String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
}

// معجم الكلمات القديمة: يربط كلمة في المعجم بكل موضع ظهرت فيه
// داخل المحتوى، ليصبح النقر عليها ممكنًا من واجهة القراءة.
model TermOccurrence {
  id          String   @id @default(cuid())
  termId      String
  contentType ContentType
  contentId   String
  passageId   String?
  createdAt   DateTime @default(now())

  term    VocabularyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  passage Passage?       @relation(fields: [passageId], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
  @@index([termId])
}

// أرشيف الرواة: توثيق الروايات الشفهية المسجّلة صوتيًا.
model Narrator {
  id        String   @id @default(cuid())
  slug      String   @unique
  fullName  String
  bio       String?
  region    String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recordings Recording[]
}

model Recording {
  id                String   @id @default(cuid())
  narratorId        String
  title             String
  recordedAt        DateTime?
  recordingLocation String?
  consentGiven      Boolean  @default(false)
  audioUrl          String?
  transcript        String?
  difficultWords    Json?
  category          String?
  status            ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(ORAL)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  narrator Narrator @relation(fields: [narratorId], references: [id], onDelete: Cascade)
}

// =========================================================
// قاعدة المعرفة: الصلاحيات، خط أنابيب الاستيراد، التحقق،
// كشف التكرار، الحقوق، اقتراحات المستخدمين.
// =========================================================

// رمز مؤقت لإنشاء أول حساب OWNER عبر CLI فقط — لا كلمة مرور ثابتة في الكود.
model OwnerBootstrapToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  used      Boolean  @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// نسخة/رواية للقصيدة — قصيدة واحدة قد تُروى بأكثر من نسخة (رواية متداولة،
// رواية ديوان محقق، رواية شفهية...)، ولكل نسخة أبياتها الخاصة.
model PoemVersion {
  id                String   @id @default(cuid())
  poemId            String
  label             String
  isPrimary         Boolean  @default(false)
  sourceNotes       String?
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  status            ContentStatus @default(DRAFT)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  reviewedBy        String?

  poem   Poem        @relation(fields: [poemId], references: [id], onDelete: Cascade)
  verses PoemVerse[]

  @@index([poemId])
}

// بيت شعري مستقل تابع لنسخة قصيدة محددة: شرح وقصة وكلمات صعبة، بدل عرض
// القصيدة كنص واحد.
model PoemVerse {
  id              String   @id @default(cuid())
  versionId       String
  orderIndex      Int
  text            String
  explanation     String?
  occasion        String?
  difficultyWords Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  version  PoemVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  variants PoemVerseVariant[]

  @@index([versionId])
}

// رواية مختلفة لنفس البيت (اختلاف نص بين مصدرين أو راويين لنفس البيت داخل
// نفس نسخة القصيدة)، منفصلة عن نسخة القصيدة الكاملة (PoemVersion).
model PoemVerseVariant {
  id          String   @id @default(cuid())
  verseId     String
  text        String
  sourceNotes String?
  createdAt   DateTime @default(now())
  createdBy   String?

  verse PoemVerse @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@index([verseId])
}

// حالة نسبة القصيدة لشاعر — قد يوجد أكثر من مُرشَّح لنسبة القصيدة إليه مع
// اختلاف الروايات حول ذلك.
model PoemAttribution {
  id          String   @id @default(cuid())
  poemId      String
  poetId      String?
  claimedName String?
  consensus   ConsensusStatus @default(AGREED)
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String?

  poem Poem  @relation(fields: [poemId], references: [id], onDelete: Cascade)
  poet Poet? @relation(fields: [poetId], references: [id])

  @@index([poemId])
}

// صفحة موضوعية تجمع عدة أنواع محتوى (مثال: "الخيل" كموضوع).
model Topic {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String?
  body      String?
  imageUrl  String?
  status    ContentStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
}

// مقال عام لمحتوى لا ينتمي لنوع مخصص (حرف، ألعاب شعبية، أكلات شعبية، عادات).
model Article {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  summary           String?
  body              String
  category          String
  status            ContentStatus @default(DRAFT)
  verificationLevel VerificationLevel @default(UNDER_REVIEW)
  language          String   @default("ar")
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  createdBy         String?
  reviewedBy        String?
  publishedBy       String?
}

// تنويعات اسم عنصر (شخص أو مكان): كنية، لقب، تهجئة بديلة — لكشف التكرار والبحث.
model NameVariant {
  id          String   @id @default(cuid())
  contentType ContentType
  contentId   String
  name        String
  variantType NameVariantType @default(ALT_NAME)
  createdAt   DateTime @default(now())

  @@index([contentType, contentId])
  @@index([name])
}

// حالة الحقوق لأي عنصر محتوى أو ملف وسائط — لا يُنشر شيء حالته UNKNOWN أو RESTRICTED.
model RightsRecord {
  id                String   @id @default(cuid())
  contentType       ContentType
  contentId         String
  status            RightsStatus @default(UNKNOWN)
  licenseName       String?
  licenseUrl        String?
  permissionDocUrl  String?
  grantedByName     String?
  grantedAt         DateTime?
  expiresAt         DateTime?
  note              String?
  recordedById      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recordedBy User? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([contentType, contentId])
}

// صندوق اقتراحات المستخدمين العاديين — لا يُنشر إلا باعتماد OWNER.
model ContentSuggestion {
  id               String   @id @default(cuid())
  contentType      ContentType?
  contentId        String?
  suggestionType   SuggestionType
  title            String
  body             String
  proposedSourceId String?
  submittedById    String
  status           SuggestionStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime @default(now())

  submittedBy    User    @relation("SuggestionSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy     User?   @relation("SuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  proposedSource Source? @relation(fields: [proposedSourceId], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
  @@index([status])
}

// مصدر بيانات معتمد للاستيراد (جهة/جهاز يُجلب منه المحتوى الخام) — منفصل عن Source (الاستشهاد).
model IngestionSource {
  id               String   @id @default(cuid())
  name             String
  organization     String?
  baseUrl          String?
  sourceType       String
  tier             Int      @default(5)
  allowedUseNote   String?
  robotsCheckedAt  DateTime?
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  jobs IngestionJob[]
}

model IngestionJob {
  id              String   @id @default(cuid())
  sourceId        String?
  method          IngestionMethod
  status          IngestionJobStatus @default(PENDING)
  startedAt       DateTime?
  finishedAt      DateTime?
  recordCount     Int      @default(0)
  acceptedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  rawFileUrl      String?
  cleanedFileUrl  String?
  notes           String?
  createdById     String
  approvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  source     IngestionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy  User @relation("IngestionJobCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy User? @relation("IngestionJobApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  records    IngestionRecord[]
  batches    PublishingBatch[]
}

model IngestionRecord {
  id                  String   @id @default(cuid())
  jobId               String
  externalRef         String?
  targetContentType   ContentType
  stage               IngestionStage @default(COLLECTED)
  rawData             Json
  normalizedData      Json?
  publishedContentId  String?
  rejectionReason     String?
  publishingBatchId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  job              IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  publishingBatch  PublishingBatch? @relation(fields: [publishingBatchId], references: [id], onDelete: SetNull)
  validationResults ValidationResult[]
  duplicateCandidates DuplicateCandidate[]

  @@index([jobId, stage])
}

model ValidationResult {
  id          String   @id @default(cuid())
  recordId    String
  checkType   ValidationCheckType
  passed      Boolean
  note        String?
  checkedById String?
  checkedAt   DateTime @default(now())

  record    IngestionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  checkedBy User? @relation(fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([recordId])
}

model DuplicateCandidate {
  id                  String   @id @default(cuid())
  recordId            String?
  existingContentType ContentType?
  existingContentId   String?
  similarityScore     Float?
  matchReason         String
  status              DuplicateStatus @default(PENDING)
  resolvedById        String?
  resolvedAt          DateTime?
  mergeNote           String?
  createdAt           DateTime @default(now())

  record     IngestionRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([existingContentType, existingContentId])
}

model PublishingBatch {
  id             String   @id @default(cuid())
  jobId          String?
  label          String
  publishedById  String
  publishedAt    DateTime @default(now())
  canRollback    Boolean  @default(true)
  rolledBackAt   DateTime?
  rolledBackById String?

  job          IngestionJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  publishedBy  User @relation("PublishingBatchPublishedBy", fields: [publishedById], references: [id], onDelete: Cascade)
  rolledBackBy User? @relation("PublishingBatchRolledBackBy", fields: [rolledBackById], references: [id], onDelete: SetNull)
  records      IngestionRecord[]
}

// =========================================================
// تصنيف الشعر متعدد الأبعاد، مكتبة الشاعر، العضويات المهنية،
// الموافقات الصريحة، ووثائق السياسات.
// =========================================================

// مصطلح تصنيفي للشعر ضمن بُعد محدد (تقليد/عصر/غرض/منطقة/أداء/مجموعة).
// جدول لا enum: المالك يضيف ويعدّل ويرتّب ويخفي ويُنشئ تصنيفات فرعية
// دون تعديل المخطط أو إصدار نسخة جديدة من التطبيق.
model PoetryTaxonomyTerm {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  description String?
  dimension   PoetryTaxonomyDimension
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  // عند دمج تصنيفين يبقى القديم مع إشارة إلى الجديد بدل حذفه،
  // حتى لا تنكسر الروابط أو المرجعيات الخارجية.
  mergedIntoId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent     PoetryTaxonomyTerm?  @relation("PoetryTaxonomyParent", fields: [parentId], references: [id], onDelete: SetNull)
  children   PoetryTaxonomyTerm[] @relation("PoetryTaxonomyParent")
  mergedInto PoetryTaxonomyTerm?  @relation("PoetryTaxonomyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom PoetryTaxonomyTerm[] @relation("PoetryTaxonomyMerge")
  poems      PoemTaxonomy[]

  @@index([dimension, isActive])
  @@index([parentId])
}

// ربط القصيدة بمصطلح تصنيفي. متعدد-إلى-متعدد لأن القصيدة قد تكون
// نبطية + في الغزل + من منطقة + من عصر معيّن في آنٍ واحد.
model PoemTaxonomy {
  id        String   @id @default(cuid())
  poemId    String
  termId    String
  createdAt DateTime @default(now())

  poem Poem               @relation(fields: [poemId], references: [id], onDelete: Cascade)
  term PoetryTaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([poemId, termId])
  @@index([termId])
}

// مكتبة الشاعر: حاوية واحدة لكل شاعر تجمع كل المواد المرتبطة به.
model PoetFile {
  id          String   @id @default(cuid())
  poetId      String   @unique
  overview    String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdBy   String?
  publishedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poet  Poet @relation(fields: [poetId], references: [id], onDelete: Cascade)
  items PoetFileItem[]
}

// مادة داخل مكتبة الشاعر. الحقول المستخدمة تعتمد على kind:
// TEXT يستخدم bodyText، EXTERNAL_LINK يستخدم externalUrl،
// وبقية الأنواع تستخدم mediaUrl.
//
// بوابة الحقوق: لا يجوز نشر AUDIO/VIDEO/IMAGE/DOCUMENT ما لم تكن
// rightsStatus من الحالات المسموح بها وallowDisplay = true.
// هذا مفروض في الخدمة لا في الواجهة فقط.
model PoetFileItem {
  id           String   @id @default(cuid())
  poetFileId   String
  kind         PoetFileItemKind
  title        String
  description  String?
  bodyText     String?
  mediaUrl     String?
  externalUrl  String?
  mediaFileId  String?
  poemId       String?
  durationMs   Int?

  occasion     String?
  materialDate String?
  materialDatePrecision DatePrecision @default(UNKNOWN)
  reciterName  String?
  capturedByName String?
  sourceId     String?
  sourceNotes  String?

  rightsHolder String?
  rightsStatus RightsStatus @default(UNKNOWN)
  licenseName  String?
  allowDisplay    Boolean @default(false)
  allowDownload   Boolean @default(false)
  allowCommercial Boolean @default(false)

  documentationLevel VerificationLevel @default(UNDER_REVIEW)
  internalNotes String?
  reviewState  ContributionReviewState @default(DRAFT)
  status       ContentStatus @default(DRAFT)
  sortOrder    Int      @default(0)

  contributedById String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  publishedById String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  poetFile      PoetFile @relation(fields: [poetFileId], references: [id], onDelete: Cascade)
  poem          Poem? @relation(fields: [poemId], references: [id], onDelete: SetNull)
  source        Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  contributedBy User? @relation("PoetFileItemContributedBy", fields: [contributedById], references: [id], onDelete: SetNull)
  reviewedBy    User? @relation("PoetFileItemReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedBy   User? @relation("PoetFileItemPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([poetFileId, status])
  @@index([kind])
  @@index([reviewState])
}

// طلب عضوية مهنية (راوٍ أو مؤرخ).
//
// فصل صريح بين البيانات العامة والبيانات الخاصة:
// حقول public* هي وحدها القابلة للعرض للعامة بعد القبول.
// حقول التحقق (الهاتف، وسيلة التواصل، الإثباتات) خاصة دائمًا
// ولا تُعاد في أي نقطة API عامة مهما كانت حالة الطلب.
model ContributorApplication {
  id     String @id @default(cuid())
  userId String
  type   ContributorType

  // ---- بيانات عامة (تُعرض بعد القبول والموافقة الصريحة) ----
  publicDisplayName String
  publicBio         String
  publicSpecialties String
  publicAvatarUrl   String?
  publicCountry     String?
  publicRegion      String?

  // ---- بيانات خاصة للتحقق فقط — لا تُعرض للعامة إطلاقًا ----
  privateFullName        String
  privateEmail           String
  privatePhoneNumber     String?
  privatePreferredContact String?
  privateExperience      String
  privateKnowledgeSources String?
  privateReliesOnOralTradition Boolean @default(false)
  privateHasRecordings   Boolean @default(false)
  privateHasDocuments    Boolean @default(false)
  privateCredentials     String?
  privatePublications    String?
  privateProfessionalLinks String?
  privateVerificationNotes String?
  privateSampleWorkUrl   String?

  status       ContributorApplicationStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  infoRequestedNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User @relation("ContributorApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ContributorApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, type])
  @@index([status])
}

// سجل موافقة صريحة. يحفظ نص الموافقة كما عُرض وقت القبول
// (لا مجرد إشارة إليه) حتى يمكن إثبات ما وافق عليه المستخدم فعلًا
// حتى لو تغيّر نص السياسة لاحقًا.
model ConsentRecord {
  id            String @id @default(cuid())
  userId        String
  consentType   ConsentType
  documentVersion String
  consentText   String
  // البيانات التي وافق صراحةً على نشرها، كمصفوفة مفاتيح.
  grantedScopes Json?
  grantedAt     DateTime @default(now())
  withdrawnAt   DateTime?
  withdrawnNote String?
  createdAt     DateTime @default(now())

  user User @relation("ConsentRecordUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

// وثيقة سياسة قابلة للتحرير من لوحة المالك، مع حفظ كل إصدار
// وتاريخ سريانه بدل الكتابة فوق النص السابق.
model PolicyDocument {
  id            String @id @default(cuid())
  code          PolicyDocumentCode
  version       String
  titleAr       String
  bodyAr        String
  effectiveFrom DateTime @default(now())
  isCurrent     Boolean  @default(false)
  // يُطلب قبول جديد من المستخدمين عند تغيير جوهري.
  requiresReacceptance Boolean @default(false)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  acceptances PolicyAcceptance[]

  @@unique([code, version])
  @@index([code, isCurrent])
}

model PolicyAcceptance {
  id         String @id @default(cuid())
  userId     String
  documentId String
  acceptedAt DateTime @default(now())

  user     User           @relation("PolicyAcceptanceUser", fields: [userId], references: [id], onDelete: Cascade)
  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
}
